---
import Base from '../../layouts/Base.astro';
import Kpi from '../../components/Kpi.astro';
import Seccion from '../../components/Seccion.astro';
import Icono from '../../components/Icono.astro';
import MapaTerritorial from '../../components/islas/MapaTerritorial.vue';
import { edicion, mostrar } from '../../lib/datos';
import { rutasEdicion } from '../../lib/filtros';
import { indicadoresMapa, propsMapa } from '../../lib/distritos';
import { EDICIONES, MODULOS } from '../../config/sitio';
import { urlEd } from '../../lib/rutas';

export const getStaticPaths = rutasEdicion;
const { anio } = Astro.params as { anio: string };
const ed = edicion(anio);
const E = EDICIONES.find(e => e.anio === anio)!;
const F = ed.ficha;
const c1 = ed.tabla('c01').rows, fila = (n: string) => c1.find(r => r[0].startsWith(n))!;
const pag = (id: string) => `${ed.tabla(id).ref} · pág. ${ed.tabla(id).pag}`;
const nEESS = ed.geoEstablecimientos?.features.filter((f: any) => f.properties.institucion === 'MINSA').length ?? 0;
---
<Base anio={anio} modulo="" titulo="Inicio" indice={[{ id: 'cifras', t: 'Cifras clave' }, { id: 'mapa', t: 'Mapa de la provincia' }, { id: 'hallazgos', t: 'Hallazgos del documento' }, { id: 'problemas', t: 'Problemas priorizados' }, { id: 'modulos', t: 'Explorar por módulo' }]}>
  <section class="aparecer relative overflow-hidden rounded-3xl bg-[linear-gradient(135deg,var(--inst-marino)_0%,#304684_55%,#0b6fa5_100%)] px-5 py-8 text-white sm:px-8 sm:py-10">
    <div class="pointer-events-none absolute -right-24 -top-24 size-[380px] rounded-full bg-[radial-gradient(closest-side,rgba(0,135,198,.55),transparent)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/3 size-[320px] rounded-full bg-[radial-gradient(closest-side,rgba(224,227,50,.16),transparent)]" aria-hidden="true"></div>
    <div class="franja absolute inset-x-0 top-0" aria-hidden="true"></div>
    <div class="relative max-w-4xl">
      <p class="text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-[var(--inst-amarillo)]">Red Integrada de Salud (RIS) San Miguel · Dirección Regional de Salud (DIRESA) Cajamarca</p>
      <h1 class="mt-2 text-[1.75rem] font-extrabold leading-tight sm:text-[2.4rem]">{E.titulo}</h1>
      <p class="mt-3 max-w-3xl text-white/85">Observatorio digital del Análisis de Situación de Salud (ASIS): explore los indicadores demográficos, sociales, sanitarios y territoriales de los 13 distritos de la provincia, con la fuente y la página de cada cifra.</p>
      <dl class="mt-6 grid gap-4 text-[0.9rem] sm:grid-cols-2 lg:grid-cols-4">
        <div><dt class="text-[0.72rem] uppercase tracking-wider text-white/65">Ámbito</dt><dd class="mt-0.5">13 distritos · 5 microrredes · 48 IPRESS del primer nivel</dd></div>
        <div><dt class="text-[0.72rem] uppercase tracking-wider text-white/65">Población 2025</dt><dd class="mt-0.5">43 651 habitantes (50,1 % hombres)</dd></div>
        <div><dt class="text-[0.72rem] uppercase tracking-wider text-white/65">Periodo de los datos</dt><dd class="mt-0.5">2023-2025 (determinantes: 2017)</dd></div>
        <div><dt class="text-[0.72rem] uppercase tracking-wider text-white/65">Documento fuente</dt><dd class="mt-0.5">{F.paginas} páginas · Oficina de Epidemiología</dd></div>
      </dl>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={urlEd(anio, 'territorio/')} class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-brand no-underline hover:bg-white/90">Explorar el mapa <Icono nombre="flecha" size={16} /></a>
        <a href={urlEd(anio, 'distritos/')} class="inline-flex items-center gap-2 rounded-xl border border-white/40 px-4 py-2.5 text-sm font-semibold text-white no-underline hover:bg-white/10">Fichas por distrito</a>
        <a href={urlEd(anio, 'priorizacion/')} class="inline-flex items-center gap-2 rounded-xl border border-white/40 px-4 py-2.5 text-sm font-semibold text-white no-underline hover:bg-white/10">Líneas de acción</a>
      </div>
    </div>
  </section>

  <div class="mt-4 flex gap-3 rounded-2xl border border-[var(--notice-border)] bg-[var(--notice-bg)] p-3.5 text-[0.88rem] text-[var(--notice-ink)]" role="note">
    <span class="shrink-0"><Icono nombre="info" /></span>
    <p><b>Visualización del documento oficial.</b> Esta plataforma no es un sistema de registro, no reemplaza al HIS MINSA ni a otros sistemas oficiales y no contiene datos de personas. Las cifras se muestran tal como figuran en el ASIS; ante cualquier diferencia prevalece el documento oficial.</p>
  </div>

  <Seccion id="cifras" kicker="Resumen ejecutivo" titulo="Cifras clave del ASIS 2025" intro="Cada tarjeta muestra la cifra exacta del cuadro indicado. Toque una tarjeta para ver el detalle.">
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,200px),1fr))] gap-3">
      <Kpi etiqueta="Población 2025" valor="43 651" fuente={pag('c02')} detalle="21 846 hombres · 21 805 mujeres" icono="personas" href={urlEd(anio, 'demografia/#poblacion')} tono="acento" />
      <Kpi etiqueta="Nacimientos 2025" valor={fila('N° de nac')[3]} fuente={pag('c01')} detalle="Tasa de natalidad: 7 por 1 000" icono="personas" href={urlEd(anio, 'demografia/#dinamica')} />
      <Kpi etiqueta="Defunciones 2025" valor={fila('N° de def')[3]} fuente={pag('c01')} detalle="204 según SINADEF (Cuadro 39)" icono="pulso" href={urlEd(anio, 'demografia/#dinamica')} />
      <Kpi etiqueta="Esperanza de vida al nacer" valor={fila('Esperanza')[3]} sufijo=" años" fuente={pag('c01')} detalle="76,3 (2023) · 76,4 (2024)" icono="pulso" href={urlEd(anio, 'demografia/#dinamica')} />
      <Kpi etiqueta="Afiliados al SIS 2025" valor="56 670" fuente={pag('t02')} detalle="Seguro Integral de Salud" icono="escudo" href={urlEd(anio, 'demografia/#sis')} />
      <Kpi etiqueta="Establecimientos de salud" valor="48" fuente={pag('c05')} detalle="Todos del primer nivel de atención" icono="hospital" href={urlEd(anio, 'servicios/#establecimientos')} />
      <Kpi etiqueta="Trabajadores de la Red" valor="366" fuente={pag('c12')} detalle="342 asistenciales · 24 administrativos" icono="personas" href={urlEd(anio, 'servicios/#rrhh')} />
      <Kpi etiqueta="Atenciones por morbilidad" valor="137 266" fuente={pag('c32')} detalle="1.ª causa: infecciones respiratorias (28,1 %)" icono="pulso" href={urlEd(anio, 'epidemiologia/#morbilidad')} tono="acento" />
      <Kpi etiqueta="Muertes maternas 2025" valor="0" fuente={pag('c46')} detalle="1 caso en 2024" icono="escudo" href={urlEd(anio, 'epidemiologia/#materna')} />
      <Kpi etiqueta="Muertes perinatales 2025" valor="6" fuente={pag('c46')} detalle="1 (2023) · 3 (2024)" icono="pulso" href={urlEd(anio, 'epidemiologia/#materna')} />
      <Kpi etiqueta="Disponibilidad de medicamentos" valor="96,67" sufijo=" %" fuente={pag('g02')} detalle="Meta regional: más de 90 %" icono="hospital" href={urlEd(anio, 'servicios/#medicamentos')} />
      <Kpi etiqueta="EE. SS. con infraestructura en mal estado" valor="34" sufijo=" de 48" fuente={pag('c28')} detalle="70,8 % de los establecimientos" icono="alerta" href={urlEd(anio, 'servicios/#infraestructura')} />
      <Kpi etiqueta="EE. SS. con acceso a internet" valor="31" sufijo=" de 48" fuente={pag('c31')} detalle="64,6 % de los establecimientos" icono="enlace" href={urlEd(anio, 'servicios/#tic')} />
      <Kpi etiqueta="Viviendas con agua potable" valor="49,3" sufijo=" %" fuente={pag('t09') + ' · datos 2017'} detalle="San Gregorio: 17,1 %" icono="casa" href={urlEd(anio, 'determinantes/')} />
      <Kpi etiqueta="Pobreza monetaria" valor="52,9" sufijo=" %" fuente={pag('t03') + ' · datos 2017'} detalle="San Silvestre de Cochán: 70,1 %" icono="casa" href={urlEd(anio, 'determinantes/')} />
    </div>
  </Seccion>

  <Seccion id="mapa" kicker="Territorio" titulo="Mapa de la provincia de San Miguel" intro={`Elija un indicador del ASIS para colorear los distritos. Los puntos son los ${nEESS} establecimientos del MINSA georreferenciados por el IGN.`}>
    <div class="tarjeta p-4 sm:p-5">
      <MapaTerritorial client:visible {...propsMapa(ed, urlEd(anio, 'datos/'))} indicadores={indicadoresMapa(ed)} inicial="t03" urlFicha={urlEd(anio, 'distritos/')} alto={440} />
    </div>
  </Seccion>

  <Seccion id="hallazgos" kicker="Capítulo X" titulo="Hallazgos destacados" intro="Conclusiones del documento, reproducidas de forma literal (pág. 93).">
    <ol class="grid gap-3 md:grid-cols-2">
      {ed.texto.conclusiones.map((c, i) => (
        <li class="tarjeta flex gap-3 p-4">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent-soft text-sm font-bold text-accent">{i + 1}</span>
          <p class="text-[0.95rem]">{c}</p>
        </li>
      ))}
    </ol>
  </Seccion>

  <Seccion id="problemas" kicker="Capítulo VII" titulo="Principales problemas sanitarios priorizados" intro="Según la matriz de priorización del Consejo Provincial de Salud (pág. 72). El documento indica «once problemas» y enumera los siguientes.">
    <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {ed.texto.priorizados.map(p => <li class="tarjeta flex items-center gap-3 px-4 py-3 text-[0.93rem]"><span class="text-accent"><Icono nombre="bandera" size={18} /></span>{p}</li>)}
    </ul>
    <p><a href={urlEd(anio, 'priorizacion/')} class="font-semibold">Ver vinculación con los instrumentos de gestión y líneas de acción →</a></p>
  </Seccion>

  <Seccion id="modulos" kicker="Navegación" titulo="Explorar por módulo">
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,250px),1fr))] gap-3">
      {MODULOS.filter(m => m.ruta).map(m => (
        <a href={urlEd(anio, m.ruta)} class="tarjeta group flex gap-3 p-4 no-underline hover:shadow-lg">
          <span class="h-fit rounded-xl bg-accent-soft p-2.5 text-accent"><Icono nombre={m.icono} size={22} /></span>
          <span><b class="block text-ink group-hover:text-accent">{m.titulo}</b><span class="mt-0.5 block text-[0.85rem] text-ink-2">{m.descripcion}</span></span>
        </a>
      ))}
    </div>
  </Seccion>
</Base>
