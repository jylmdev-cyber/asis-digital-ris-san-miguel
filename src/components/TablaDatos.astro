---
// Tabla estática (HTML puro, sin JavaScript). Cifras alineadas a la derecha y tal como en el documento.
import { mostrar, num, esTotal } from '../lib/datos';
interface Props { cols: string[]; rows: string[][]; titulo: string; largos?: number[]; resaltar?: string; maxAlto?: boolean }
const { cols, rows, titulo, largos = [], resaltar, maxAlto = true } = Astro.props;
const esN = (x: string, i: number) => i > 0 && num(x) != null;
---
<div class="tabla-wrap" style={maxAlto ? undefined : 'max-height:none'} tabindex="0" role="region" aria-label={`Tabla: ${titulo}`}>
  <table class="tabla">
    <caption class="sr-only">{titulo}</caption>
    <thead><tr>{cols.map((c, i) => <th scope="col" class:list={[i > 0 && rows.some(r => esN(r[i], i)) && rows.filter(r => !esTotal(r)).every(r => !r[i] || esN(r[i], i)) && 'n']}>{c}</th>)}</tr></thead>
    <tbody>
      {rows.map(r => (
        <tr class:list={[esTotal(r) && 'tot', resaltar && r[0] === resaltar && 'hl']}>
          {r.map((x, i) => <td class:list={[esN(x, i) && 'n', largos.includes(i) && 'largo']}>{esN(x, i) ? mostrar(x) : (x || '–')}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
